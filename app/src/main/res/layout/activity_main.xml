<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Крестики-нолики"
            android:textColor="#2196F3"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/themeBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="🌙"
            android:textSize="18sp"
            android:backgroundTint="#2A2A3A"
            android:textColor="#FFFFFF"
            android:minWidth="50dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:id="@+id/playerXPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="#212121"
            android:layout_marginEnd="4dp">

            <TextView
                android:id="@+id/playerXName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Игрок X"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/playerXScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#2196F3"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/playerOPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="#212121"
            android:layout_marginStart="4dp">

            <TextView
                android:id="@+id/playerOName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Игрок O"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/playerOScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#00BCD4"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ход игрока X"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/timerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏱ 30 сек"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:id="@+id/boardContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/newGameBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="НОВАЯ ИГРА"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2196F3"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/changeModeBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="СМЕНИТЬ РЕЖИМ"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#AAAAAA"
        android:backgroundTint="#212121" />

</LinearLayout>
